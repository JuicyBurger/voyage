NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # sb_publishable_… (browser apikey)
SUPABASE_SECRET_KEY=                    # sb_secret_… (server writes only)
HOST_PASSWORDS=                         # comma-separated; each can create games
ALLOW_TEST_HOOKS=                       # set to 1 only on a local project
SUPABASE_JWT_SIGNING_KEY=               # private JWK JSON (same key as supabase/signing_keys.json)
